{
  "manifest_version": 3,
  "name": "Webscanner",
  "version": "0.1.0",
  "description": "Bulk number scanner with a WhatsApp flow.",
  "permissions": ["storage"],
  "host_permissions": ["https://webscanner.djgroup-dev.com/*"],
  "action": {
    "default_title": "Webscanner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
