{
  "manifest_version": 3,
  "name": "Webscanner",
  "version": "0.1.0",
  "description": "Bulk scanner nomor dengan flow WhatsApp dummy.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Webscanner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
